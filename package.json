  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:host && npm run build:webview",
    "build:host": "node esbuild.mjs --prod",
    "build:webview": "node build-webview.mjs",
    "watch": "concurrently \"npm run watch:host\" \"npm run watch:webview\"",
    "watch:host": "node esbuild.mjs --watch",
    "watch:webview": "node build-webview.mjs --watch",
    "package": "vsce package",
    "publish": "vsce publish",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "npm run typecheck:host && npm run typecheck:webview",
    "typecheck:host": "tsc --noEmit --composite false --incremental false -p tsconfig.host.json",
    "typecheck:webview": "tsc --noEmit --incremental false -p tsconfig.webview.json",
    "test:scrollbars": "node scripts/test-webview-scrollbars.mjs",
    "test:scrollbars:browser": "node scripts/test-webview-scrollbar-overlays.mjs",
    "bump": "node scripts/bump-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "test:tags": "node scripts/test-git-tags.mjs"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.2.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^8.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "material-icon-theme": "^5.34.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^3.23.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.6",
    "zustand": "^4.5.0"
