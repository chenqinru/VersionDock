{
  "name": "versiondock",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "4.0.6",
  "publisher": "chenqinru",
  "author": {
    "name": "chenqinru",
    "url": "https://github.com/chenqinru"
  },
  "homepage": "https://github.com/chenqinru/VersionDock#readme",
  "bugs": {
    "url": "https://github.com/chenqinru/VersionDock/issues"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenqinru/VersionDock.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "svn",
    "vcs",
    "version-control",
    "scm",
    "source-control",
    "git-graph",
    "git-history",
    "commit",
    "log",
    "merge",
    "merge-conflict",
    "merge-editor",
    "changelist",
    "shelve",
    "stash",
    "blame",
    "intellij",
    "phpstorm",
    "ai-commit",
    "copilot"
  ],
  "icon": "media/icons/versiondock-logo-dark.png",
  "galleryBanner": {
    "color": "#071b45",
    "theme": "dark"
  },
  "activationEvents": [
    "workspaceContains:**/.git",
    "workspaceContains:**/.svn",
    "onStartupFinished"
  ],
  "main": "./out/host/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "versiondock-commit",
          "title": "%viewsContainers.activitybar.commit.title%",
          "icon": "media/icons/git-commit.svg"
        }
      ],
      "panel": [
        {
          "id": "versiondock-log",
          "title": "%viewsContainers.panel.log.title%",
          "icon": "media/icons/git-branch.svg"
        }
      ]
    },
    "views": {
      "versiondock-commit": [
        {
          "type": "webview",
          "id": "versiondock.commitPanel",
          "name": "%views.commitPanel.name%",
          "retainContextWhenHidden": true
        },
        {
          "id": "versiondock.commitBadge",
          "name": "",
          "when": "false"
        }
      ],
      "versiondock-log": [
        {
          "type": "webview",
          "id": "versiondock.gitLog",
          "name": "%views.gitLog.name%",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "versiondock.openLog",
        "title": "%commands.openLog.title%",
        "icon": "$(history)"
      },
      {
        "command": "versiondock.commit",
        "title": "%commands.commit.title%"
      },
      {
        "command": "versiondock.commitAndPush",
        "title": "%commands.commitAndPush.title%"
      },
      {
        "command": "versiondock.pull",
        "title": "%commands.pull.title%"
      },
      {
        "command": "versiondock.push",
        "title": "%commands.push.title%"
      },
      {
        "command": "versiondock.fetchAll",
        "title": "%commands.fetchAll.title%"
      },
      {
        "command": "versiondock.openMergeEditor",
        "title": "%commands.openMergeEditor.title%"
      },
      {
        "command": "versiondock.openConflicts",
        "title": "%commands.openConflicts.title%",
        "icon": "$(git-merge)"
      },
      {
        "command": "versiondock.openMergeEditorFromSCM",
        "title": "%commands.openMergeEditorFromSCM.title%",
        "icon": "$(git-merge)"
      },
      {
        "command": "versiondock.showFileHistory",
        "title": "%commands.showFileHistory.title%",
        "icon": "$(history)"
      },
      {
        "command": "versiondock.showSelectionHistory",
        "title": "%commands.showSelectionHistory.title%",
        "icon": "$(selection)"
      },
      {
        "command": "versiondock.refreshCommitPanel",
        "title": "%commands.refreshCommitPanel.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "versiondock.reloadRepositories",
        "title": "%commands.reloadRepositories.title%",
        "icon": "$(sync)"
      },
      {
        "command": "versiondock.showBranchMenu",
        "title": "%commands.showBranchMenu.title%",
        "icon": "$(git-branch)"
      },
      {
        "command": "versiondock.selectAll",
        "title": "%commands.selectAll.title%",
        "icon": {
          "light": "./media/icons/select-all-light.svg",
          "dark": "./media/icons/select-all-dark.svg"
        }
      },
      {
        "command": "versiondock.invertSelection",
        "title": "%commands.invertSelection.title%",
        "icon": {
          "light": "./media/icons/invert-selection-light.svg",
          "dark": "./media/icons/invert-selection-dark.svg"
        }
      },
      {
        "command": "versiondock.showConflictActions",
        "title": "%commands.showConflictActions.title%",
        "icon": {
          "light": "./media/icons/warning-conflict-light.svg",
          "dark": "./media/icons/warning-conflict-dark.svg"
        }
      },
      {
        "command": "versiondock.updateProject",
        "title": "%commands.updateProject.title%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "versiondock.openSettings",
        "title": "%commands.openSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "versiondock.aiCommitMessage.editPrompt",
        "title": "%commands.aiCommitMessage.editPrompt.title%"
      },
      {
        "command": "versiondock.aiCommitMessage.resetPrompt",
        "title": "%commands.aiCommitMessage.resetPrompt.title%"
      },
      {
        "command": "versiondock.aiMergeConflict.editPrompt",
        "title": "%commands.aiMergeConflict.editPrompt.title%"
      },
      {
        "command": "versiondock.aiMergeConflict.resetPrompt",
        "title": "%commands.aiMergeConflict.resetPrompt.title%"
      },
      {
        "command": "versiondock.aiCommitExplanation.editPrompt",
        "title": "%commands.aiCommitExplanation.editPrompt.title%"
      },
      {
        "command": "versiondock.aiCommitExplanation.resetPrompt",
        "title": "%commands.aiCommitExplanation.resetPrompt.title%"
      },
      {
        "command": "versiondock.aiCommitComposer.editPrompt",
        "title": "%commands.aiCommitComposer.editPrompt.title%"
      },
      {
        "command": "versiondock.aiCommitComposer.resetPrompt",
        "title": "%commands.aiCommitComposer.resetPrompt.title%"
      },
      {
        "command": "versiondock.aiCodeReview.editPrompt",
        "title": "%commands.aiCodeReview.editPrompt.title%"
      },
      {
        "command": "versiondock.aiCodeReview.resetPrompt",
        "title": "%commands.aiCodeReview.resetPrompt.title%"
      },
      {
        "command": "versiondock.aiCli.check",
        "title": "%commands.aiCli.check.title%"
      },
      {
        "command": "versiondock.aiCli.resetAntigravitySession",
        "title": "%commands.aiCli.resetAntigravitySession.title%"
      },
      {
        "command": "versiondock.openGitAnnotations",
        "title": "%commands.openGitAnnotations.title%",
        "icon": "$(git-commit)"
      },
      {
        "command": "versiondock.closeGitAnnotations",
        "title": "%commands.closeGitAnnotations.title%",
        "icon": "$(git-commit)"
      },
      {
        "command": "versiondock.openGitGhostText",
        "title": "%commands.openGitGhostText.title%",
        "icon": "$(symbol-text)"
      },
      {
        "command": "versiondock.closeGitGhostText",
        "title": "%commands.closeGitGhostText.title%",
        "icon": "$(symbol-text)"
      },
      {
        "command": "versiondock.openSvnAnnotations",
        "title": "%commands.openSvnAnnotations.title%",
        "icon": "$(git-commit)"
      },
      {
        "command": "versiondock.closeSvnAnnotations",
        "title": "%commands.closeSvnAnnotations.title%",
        "icon": "$(git-commit)"
      },
      {
        "command": "versiondock.openSvnGhostText",
        "title": "%commands.openSvnGhostText.title%",
        "icon": "$(symbol-text)"
      },
      {
        "command": "versiondock.closeSvnGhostText",
        "title": "%commands.closeSvnGhostText.title%",
        "icon": "$(symbol-text)"
      },
      {
        "command": "versiondock.navigateToAnnotationCommit",
        "title": "%commands.navigateToAnnotationCommit.title%"
      },
      {
        "command": "versiondock.manageHiddenRepos",
        "title": "%commands.manageHiddenRepos.title%",
        "category": "VersionDock",
        "icon": "$(eye-closed)"
      },
      {
        "command": "versiondock.manageProfiles",
        "title": "%commands.manageProfiles.title%",
        "icon": "$(account)"
      },
      {
        "command": "versiondock.switchProfile",
        "title": "%commands.switchProfile.title%",
        "icon": "$(account)"
      },
      {
        "command": "versiondock.submodule.init",
        "title": "%commands.submoduleInit.title%"
      },
      {
        "command": "versiondock.submodule.update",
        "title": "%commands.submoduleUpdate.title%"
      },
      {
        "command": "versiondock.submodule.updateRecursive",
        "title": "%commands.submoduleUpdateRecursive.title%"
      },
      {
        "command": "versiondock.submodule.deinit",
        "title": "%commands.submoduleDeinit.title%"
      },
      {
        "command": "versiondock.submodule.deinitForce",
        "title": "%commands.submoduleDeinitForce.title%"
      },
      {
        "command": "versiondock.submodule.openInNewWindow",
        "title": "%commands.submoduleOpenInNewWindow.title%"
      },
      {
        "command": "versiondock.worktree.add",
        "title": "%commands.worktreeAdd.title%"
      },
      {
        "command": "versiondock.worktree.prune",
        "title": "%commands.worktreePrune.title%"
      },
      {
        "command": "versiondock.subtree.add",
        "title": "%commands.subtreeAdd.title%"
      },
      {
        "command": "versiondock.subtree.pull",
        "title": "%commands.subtreePull.title%"
      },
      {
        "command": "versiondock.subtree.push",
        "title": "%commands.subtreePush.title%"
      },
      {
        "command": "versiondock.subtree.split",
        "title": "%commands.subtreeSplit.title%"
      },
      {
        "command": "versiondock.subtree.merge",
        "title": "%commands.subtreeMerge.title%"
      },
      {
        "command": "versiondock.subtree.remove",
        "title": "%commands.subtreeRemove.title%"
      },
      {
        "command": "versiondock.subtree.manage",
        "title": "%commands.subtreeManage.title%"
      },
      {
        "command": "versiondock.svn.cleanup",
        "title": "%commands.svnCleanup.title%",
        "icon": "$(tools)"
      },
      {
        "command": "versiondock.svn.resolveWorking",
        "title": "%commands.svnResolveWorking.title%",
        "icon": "$(check)"
      },
      {
        "command": "versiondock.svn.lock",
        "title": "%commands.svnLock.title%",
        "icon": "$(lock)"
      },
      {
        "command": "versiondock.svn.unlock",
        "title": "%commands.svnUnlock.title%",
        "icon": "$(unlock)"
      },
      {
        "command": "versiondock.svn.relocate",
        "title": "%commands.svnRelocate.title%",
        "icon": "$(link)"
      },
      {
        "command": "versiondock.svn.switch",
        "title": "%commands.svnSwitch.title%",
        "icon": "$(git-branch)"
      },
      {
        "command": "versiondock.svn.createBranch",
        "title": "%commands.svnCreateBranch.title%",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "versiondock.svn.createTag",
        "title": "%commands.svnCreateTag.title%",
        "icon": "$(tag)"
      },
      {
        "command": "versiondock.svn.checkout",
        "title": "%commands.svnCheckout.title%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "versiondock.git.clone",
        "title": "%commands.gitClone.title%",
        "icon": "$(repo-clone)"
      },
      {
        "command": "versiondock.git.publish",
        "title": "%commands.gitPublish.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "versiondock.manageRemoteAccounts",
        "title": "%commands.manageRemoteAccounts.title%",
        "icon": "$(account)"
      },
      {
        "command": "versiondock.expandAll",
        "title": "%commands.expandAll.title%"
      },
      {
        "command": "versiondock.expandAll.checked",
        "title": "%commands.expandAll.checked.title%"
      },
      {
        "command": "versiondock.collapseAll",
        "title": "%commands.collapseAll.title%"
      },
      {
        "command": "versiondock.collapseAll.checked",
        "title": "%commands.collapseAll.checked.title%"
      },
      {
        "command": "versiondock.setFileViewModeToFlat",
        "title": "%commands.setFileViewModeToFlat.title%"
      },
      {
        "command": "versiondock.setFileViewModeToFlat.checked",
        "title": "%commands.setFileViewModeToFlat.checked.title%"
      },
      {
        "command": "versiondock.setFileViewModeToTree",
        "title": "%commands.setFileViewModeToTree.title%"
      },
      {
        "command": "versiondock.setFileViewModeToTree.checked",
        "title": "%commands.setFileViewModeToTree.checked.title%"
      }
    ],
    "submenus": [
      {
        "id": "versiondock.commitPanel.expandMode",
        "label": "%submenus.commitPanel.expandMode.label%"
      },
      {
        "id": "versiondock.commitPanel.viewMode",
        "label": "%submenus.commitPanel.viewMode.label%"
      },
      {
        "id": "versiondock.context.editor",
        "label": "VersionDock"
      },
      {
        "id": "versiondock.context.explorer",
        "label": "VersionDock"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "versiondock.showConflictActions",
          "when": "view == versiondock.commitPanel && versiondock.hasConflicts",
          "group": "navigation@0"
        },
        {
          "command": "versiondock.selectAll",
          "when": "view == versiondock.commitPanel && versiondock.canSelectAll && !versiondock.isAllSelected",
          "group": "navigation@0.5"
        },
        {
          "command": "versiondock.invertSelection",
          "when": "view == versiondock.commitPanel && versiondock.canSelectAll && versiondock.isAllSelected",
          "group": "navigation@0.5"
        },
        {
          "command": "versiondock.updateProject",
          "when": "view == versiondock.commitPanel",
          "group": "navigation@1"
        },
        {
          "command": "versiondock.refreshCommitPanel",
          "when": "view == versiondock.commitPanel",
          "group": "navigation@2"
        },
        {
          "command": "versiondock.showBranchMenu",
          "when": "view == versiondock.commitPanel",
          "group": "navigation@3"
        },
        {
          "command": "versiondock.openLog",
          "when": "view == versiondock.commitPanel",
          "group": "navigation@4"
        },
        {
          "command": "versiondock.manageRemoteAccounts",
          "when": "view == versiondock.commitPanel",
          "group": "navigation@5"
        },
        {
          "command": "versiondock.openSettings",
          "when": "view == versiondock.commitPanel",
          "group": "navigation@6"
        },
        {
          "submenu": "versiondock.commitPanel.expandMode",
          "when": "view == versiondock.commitPanel",
          "group": "1_options@1"
        },
        {
          "submenu": "versiondock.commitPanel.viewMode",
          "when": "view == versiondock.commitPanel",
          "group": "1_options@2"
        },
        {
          "command": "versiondock.manageHiddenRepos",
          "when": "view == versiondock.commitPanel && versiondock.isMultiRepo",
          "group": "1_options@3"
        }
      ],
      "versiondock.commitPanel.expandMode": [
        {
          "command": "versiondock.expandAll.checked",
          "when": "versiondock.isExpanded",
          "group": "1_expand@1"
        },
        {
          "command": "versiondock.expandAll",
          "when": "!versiondock.isExpanded",
          "group": "1_expand@1"
        },
        {
          "command": "versiondock.collapseAll.checked",
          "when": "versiondock.isCollapsed",
          "group": "1_expand@2"
        },
        {
          "command": "versiondock.collapseAll",
          "when": "!versiondock.isCollapsed",
          "group": "1_expand@2"
        }
      ],
      "versiondock.commitPanel.viewMode": [
        {
          "command": "versiondock.setFileViewModeToFlat.checked",
          "when": "versiondock.isFlatFileView",
          "group": "1_view@1"
        },
        {
          "command": "versiondock.setFileViewModeToFlat",
          "when": "!versiondock.isFlatFileView",
          "group": "1_view@1"
        },
        {
          "command": "versiondock.setFileViewModeToTree.checked",
          "when": "versiondock.isTreeFileView",
          "group": "1_view@2"
        },
        {
          "command": "versiondock.setFileViewModeToTree",
          "when": "!versiondock.isTreeFileView",
          "group": "1_view@2"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "versiondock.manageHiddenRepos",
          "group": "versiondock@1"
        }
      ],
      "commandPalette": [
        {
          "command": "versiondock.manageHiddenRepos"
        },
        {
          "command": "versiondock.openLog"
        },
        {
          "command": "versiondock.fetchAll"
        },
        {
          "command": "versiondock.openMergeEditor"
        },
        {
          "command": "versiondock.openConflicts"
        },
        {
          "command": "versiondock.openGitAnnotations",
          "when": "resourceScheme == file && versiondock.blameVcs == git && !versiondock.annotationsVisible"
        },
        {
          "command": "versiondock.closeGitAnnotations",
          "when": "resourceScheme == file && versiondock.blameVcs == git && versiondock.annotationsVisible"
        },
        {
          "command": "versiondock.openGitGhostText",
          "when": "resourceScheme == file && versiondock.blameVcs == git && !versiondock.ghostTextEnabledForFile"
        },
        {
          "command": "versiondock.closeGitGhostText",
          "when": "resourceScheme == file && versiondock.blameVcs == git && versiondock.ghostTextEnabledForFile"
        },
        {
          "command": "versiondock.openSvnAnnotations",
          "when": "resourceScheme == file && versiondock.blameVcs == svn && !versiondock.annotationsVisible"
        },
        {
          "command": "versiondock.closeSvnAnnotations",
          "when": "resourceScheme == file && versiondock.blameVcs == svn && versiondock.annotationsVisible"
        },
        {
          "command": "versiondock.openSvnGhostText",
          "when": "resourceScheme == file && versiondock.blameVcs == svn && !versiondock.ghostTextEnabledForFile"
        },
        {
          "command": "versiondock.closeSvnGhostText",
          "when": "resourceScheme == file && versiondock.blameVcs == svn && versiondock.ghostTextEnabledForFile"
        },
        {
          "command": "versiondock.navigateToAnnotationCommit",
          "when": "false"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "versiondock.openGitAnnotations",
          "when": "resourceScheme == file && versiondock.blameVcs == git && !versiondock.annotationsVisible",
          "group": "versiondock@1"
        },
        {
          "command": "versiondock.closeGitAnnotations",
          "when": "resourceScheme == file && versiondock.blameVcs == git && versiondock.annotationsVisible",
          "group": "versiondock@1"
        },
        {
          "command": "versiondock.openSvnAnnotations",
          "when": "resourceScheme == file && versiondock.blameVcs == svn && !versiondock.annotationsVisible",
          "group": "versiondock@1"
        },
        {
          "command": "versiondock.closeSvnAnnotations",
          "when": "resourceScheme == file && versiondock.blameVcs == svn && versiondock.annotationsVisible",
          "group": "versiondock@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "versiondock.context.editor",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "git@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "versiondock.context.explorer",
          "when": "!explorerResourceIsFolder",
          "group": "git@1"
        }
      ],
      "versiondock.context.editor": [
        {
          "command": "versiondock.openGitAnnotations",
          "when": "versiondock.blameVcs == git && !versiondock.annotationsVisible",
          "group": "annotations@1"
        },
        {
          "command": "versiondock.closeGitAnnotations",
          "when": "versiondock.blameVcs == git && versiondock.annotationsVisible",
          "group": "annotations@1"
        },
        {
          "command": "versiondock.openGitGhostText",
          "when": "versiondock.blameVcs == git && !versiondock.ghostTextEnabledForFile",
          "group": "annotations@2"
        },
        {
          "command": "versiondock.closeGitGhostText",
          "when": "versiondock.blameVcs == git && versiondock.ghostTextEnabledForFile",
          "group": "annotations@2"
        },
        {
          "command": "versiondock.openSvnAnnotations",
          "when": "versiondock.blameVcs == svn && !versiondock.annotationsVisible",
          "group": "annotations@1"
        },
        {
          "command": "versiondock.closeSvnAnnotations",
          "when": "versiondock.blameVcs == svn && versiondock.annotationsVisible",
          "group": "annotations@1"
        },
        {
          "command": "versiondock.openSvnGhostText",
          "when": "versiondock.blameVcs == svn && !versiondock.ghostTextEnabledForFile",
          "group": "annotations@2"
        },
        {
          "command": "versiondock.closeSvnGhostText",
          "when": "versiondock.blameVcs == svn && versiondock.ghostTextEnabledForFile",
          "group": "annotations@2"
        },
        {
          "command": "versiondock.showFileHistory",
          "group": "history@1"
        },
        {
          "command": "versiondock.showSelectionHistory",
          "group": "history@2"
        }
      ],
      "versiondock.context.explorer": [
        {
          "command": "versiondock.showFileHistory",
          "group": "history@1"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "versiondock.openConflicts",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "versiondock@0"
        },
        {
          "command": "versiondock.openMergeEditorFromSCM",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "versiondock@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "versiondock.openLog",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "versiondock.commit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "colors": [
      {
        "id": "versiondock.statusBarSyncForeground",
        "description": "%colors.statusBarSyncForeground.description%",
        "defaults": {
          "dark": "#4dd0e1",
          "light": "#00838f",
          "highContrast": "#4dd0e1",
          "highContrastLight": "#00838f"
        }
      },
      {
        "id": "versiondock.statusBarPullForeground",
        "description": "%colors.statusBarPullForeground.description%",
        "defaults": {
          "dark": "#64b5f6",
          "light": "#1565c0",
          "highContrast": "#64b5f6",
          "highContrastLight": "#1565c0"
        }
      },
      {
        "id": "versiondock.statusBarPushForeground",
        "description": "%colors.statusBarPushForeground.description%",
        "defaults": {
          "dark": "#81c784",
          "light": "#2e7d32",
          "highContrast": "#81c784",
          "highContrastLight": "#2e7d32"
        }
      },
      {
        "id": "versiondock.statusBarDirtyForeground",
        "description": "%colors.statusBarDirtyForeground.description%",
        "defaults": {
          "dark": "#ce93d8",
          "light": "#6a1b9a",
          "highContrast": "#ce93d8",
