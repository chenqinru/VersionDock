{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "npm run build",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "watch",
      "type": "shell",
      "command": "npm run watch",
      "isBackground": true,
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": [
        {
          "owner": "typescript",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": {
            "regexp": "^(.+)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+TS(\\d+):\\s+(.+)$",
            "file": 1, "line": 2, "column": 3, "severity": 4, "code": 5, "message": 6
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^\\[esbuild\\]",
            "endsPattern": "Watching"
          }
        }
      ]
    },
    {
      "label": "package",
      "type": "shell",
      "command": "npm run package",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Version: Bump (输入或指定版本)",
      "type": "shell",
      "command": "node scripts/bump-version.mjs ${input:targetVersion}",
      "presentation": { "reveal": "always", "panel": "shared", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Version: Bump Patch (+0.0.1)",
      "type": "shell",
      "command": "node scripts/bump-version.mjs patch",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Version: Bump Minor (+0.1.0)",
      "type": "shell",
      "command": "node scripts/bump-version.mjs minor",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Version: Bump Major (+1.0.0)",
      "type": "shell",
      "command": "node scripts/bump-version.mjs major",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "targetVersion",
      "type": "promptString",
      "description": "请输入目标版本号（如 3.3.0）或升级规则（patch / minor / major）",
      "default": "patch"
    }
  ]
}
